# 1. Product paths
LOCALFIT_RUNTIME_ROOT=runtime
LOCALFIT_DATABASE_PATH=runtime/db/commercial.db
LOCALFIT_REPORTS_ROOT=runtime/reports
LOCALFIT_DATA_ROOT=../datacorpus
LOCALFIT_RESEARCH_ROOT=../research
LOCALFIT_KEY_FILE=../docs/90_private/key.md
LOCALFIT_KNOWLEDGE_ROOT=resources/knowledge/rag_sources
# Existing users listed here are promoted idempotently at backend startup.
# For the first production admin, run this local-only command before startup:
#   python scripts/provision_admin.py --email owner@example.com
# Then set the same address below and restart. Reserved configured admin emails
# cannot be claimed through the public registration API.
# LOCALFIT_ADMIN_EMAIL=owner@example.com
# LOCALFIT_ADMIN_EMAILS=owner@example.com,ops@example.com
# A legacy DB missing users.is_admin promotes its oldest account once by default.
# Set to disabled before the first upgraded startup to require an explicit email.
LOCALFIT_LEGACY_ADMIN_BOOTSTRAP=oldest_existing
# In production, oldest-account promotion is always disabled; configure an admin email.
LOCALFIT_ENV=development
# Production deployments should provide a long random JWT signing key.
# Local development generates and persists one under runtime/auth automatically.
# SECRET_KEY=replace-with-a-long-random-value
# Comma-separated browser origins allowed to call the backend.
LOCALFIT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Core Seoul sources publish quarterly. Keep collector probe/full-refresh TTLs
# separate from the production dashboard's weekly operational warning window.
LOCALFIT_CORE_SOURCE_HEALTH_TTL_HOURS=168
# Optional spatial source overrides. Defaults resolve under LOCALFIT_DATA_ROOT.
# LOCALFIT_BOUNDARY_VERTICES_PATH=../datacorpus/_gold/gold_location_boundary_vertices.csv
# LOCALFIT_STORE_POI_PATH=../datacorpus/_silver/silver_sbdc_store_poi_seoul_202603.csv
# LOCALFIT_BUS_STOP_PATH=../datacorpus/_silver/silver_bus_stop_location_master.csv
# LOCALFIT_SUBWAY_STATION_PATH=../datacorpus/_silver/silver_subway_station_master.csv

# 2. OpenAI API (AI 상권 분석 리포트 생성용)
# 발급처: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Alias used by reports and chatbot. Provider responses may log the dated
# snapshot (for example, gpt-5.4-mini-2026-03-17) separately.
OPENAI_MODEL=gpt-5.4-mini
# Detailed-report default. An administrator override is stored in
# runtime/admin/pipeline_jobs.db and takes effect without a server restart.
OPENAI_REPORT_REASONING_EFFORT=low


# 3. 공공데이터포털 API (소상공인시장진흥공단, 건축물대장 데이터 수집용)
# 발급처: https://www.data.go.kr/
DATA_GO_KR_API_KEY=YOUR_DATA_GO_KR_API_KEY

# 4. 서울 열린데이터광장 (유동인구, 상주인구 데이터 수집용)
# 발급처: https://data.seoul.go.kr/
SEOUL_DATA_API_KEY=YOUR_SEOUL_DATA_API_KEY

# 5. 카카오 로컬 API (교통 접근성 및 위경도 좌표 변환용)
# 발급처: https://developers.kakao.com/
KAKAO_MAP_API_KEY=YOUR_KAKAO_MAP_API_KEY

#6. 부동산 R-ONE API
R_ONE_API_KEY=YOUR_R_ONE_API_KEY
